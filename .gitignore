__pycache__/
*.py[cod]
*.egg-info/
build/
!zig/build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store
*.swp
*.log
# Quantized drafter checkpoints: the artifact is 780 MB and there is no git-lfs on this box.
# manifest.json + SHA256SUMS + tools/dflash2/quantize pin it; the blob itself stays out of history.
checkpoints/*/model.safetensors
# the affine4 arm's raw words/parameters (246 MiB) are regenerated by quantize/export_affine4.py from a
# fitted codes npz; only its manifest is worth carrying, and even that is derived
checkpoints/*/affine4/*.words.u32
checkpoints/*/affine4/*.scale.bf16
checkpoints/*/affine4/*.bias.bf16
checkpoints/*/affine4/manifest.json
.zig-toolchain
.zig-cache/
zig-out/

# Native Qwen CPU-only Metal compiler receipts.
.q27-metal-check/

# The qwen4 device gate writes a scratch checkpoint into the tree and takes it away again.
.qwen4-device-*/

# A build tool that crashes leaves a core dump in the tree.
/core
*.core

# Versioned GUI build resources, generated app engines stay ignored in app/.gitignore.
!app/build/

# The full E4B per-layer input oracle outputs (tools/zig/gemma4_e4b_layer_input_oracle.py --full); the committed fixture is the .json of SHA-256 prints.
tools/zig/fixtures/e4b_layer_input_mlx.bin
tools/dflash2/runs/

# the plotting tool's own venv (matplotlib is not a repo dependency)
.venv-plot/
